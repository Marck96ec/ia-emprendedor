    { "name": "grupo con menos elementos que la meta", "schema": "contacts", "data": { "contacts": [{ "name": "Ana", "outcome": "interested" }] }, "valid": true, "issue_paths": [] },
    { "name": "grupo con más elementos de los permitidos", "schema": "contacts", "data": { "contacts": [{ "name": "Ana", "outcome": "interested" }, { "name": "Luis", "outcome": "interested" }, { "name": "Eva", "outcome": "interested" }, { "name": "Leo", "outcome": "interested" }] }, "valid": false, "issue_paths": ["contacts"] },
