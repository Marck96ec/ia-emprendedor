{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"]
    },
    "outDir": ".test-dist",
    "rootDir": ".",
    "noEmitOnError": true
  },
  "include": [
    "tests/**/*.ts",
    "tests/**/*.tsx"
  ]
}
